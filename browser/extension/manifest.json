{
  "manifest_version": 3,
  "name": "secretvault",
  "version": "0.1.0",
  "description": "Fills and saves logins from secretvault. secretvault asks you before it hands any login over.",
  "homepage_url": "https://github.com/codemodify/secretvault",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "secretvault@codemodify.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "key": "",
  "minimum_chrome_version": "121",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "scripts": ["lib/psl.js", "lib/origin.js", "lib/protocol.js", "background.js"],
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "secretvault",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Show the logins for this page"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/forms.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'"
  }
}
